<Window x:Class="ZapretGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zapret GUI" Height="600" Width="850"
        Background="#121212" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВОЕ МЕНЮ -->
        <Border Grid.Column="0" Name="Sidebar" Background="#1E1E1E" BorderBrush="#333" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="10,20,10,0">
                    <TextBlock Name="MenuMain" Text="Главная" Foreground="#4CAF50" FontSize="16" Margin="10,10" Cursor="Hand" MouseLeftButtonDown="MenuMain_Click"/>
                    <TextBlock Name="MenuProfiles" Text="Профили" Foreground="White" FontSize="16" Margin="10,10" Cursor="Hand" MouseLeftButtonDown="MenuProfiles_Click"/>
                    <TextBlock Name="MenuLists" Text="Списки" Foreground="White" FontSize="16" Margin="10,10" Cursor="Hand" MouseLeftButtonDown="MenuLists_Click"/>
                    <TextBlock Name="MenuSettings" Text="Настройки" Foreground="White" FontSize="16" Margin="10,10" Cursor="Hand" MouseLeftButtonDown="MenuSettings_Click"/>
                    <TextBlock Name="MenuLogs" Text="Логи" Foreground="White" FontSize="16" Margin="10,10" Cursor="Hand" MouseLeftButtonDown="MenuLogs_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="15,15,15,20">
                    <TextBlock Text="Статус:" Foreground="Gray" FontSize="12"/>
                    <TextBlock Name="TxtStatusLeft" Text="Отключено" Foreground="Gray" FontSize="14" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ПРАВАЯ ЧАСТЬ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Grid.Row="0" Background="#1E1E1E">
                <Grid>
                    <TextBlock Text="Zapret" Foreground="White" FontSize="20" VerticalAlignment="Center" Margin="20,0"/>
                </Grid>
            </Border>

            <!-- СТРАНИЦА 1: ГЛАВНАЯ -->
            <StackPanel Name="PageMain" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button Name="BtnMain" Width="150" Height="150" BorderThickness="0" Cursor="Hand" Click="BtnMain_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="75">
                                <TextBlock Text="⏻" FontSize="65" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock Name="TxtCurrentProfile" Text="Нынешний профиль: (не выбран)" Foreground="#4CAF50" FontFamily="Consolas" FontSize="14" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                <TextBlock Name="TxtStatusCenter" Text="Отключено" Foreground="Gray" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>

                <StackPanel Margin="0,30,0,0" HorizontalAlignment="Center">
                    <TextBlock Text="Игровой режим:" Foreground="Gray" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <ComboBox Name="CmbGameFilter" Width="200" Height="30" SelectionChanged="CmbGameFilter_SelectionChanged">
                        <ComboBoxItem Content="Выключен" Tag="disabled" IsSelected="True"/>
                        <ComboBoxItem Content="TCP + UDP" Tag="all"/>
                        <ComboBoxItem Content="Только TCP" Tag="tcp"/>
                        <ComboBoxItem Content="Только UDP" Tag="udp"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <!-- СТРАНИЦА 2: ПРОФИЛИ -->
            <Grid Name="PageProfiles" Grid.Row="1" Margin="30" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Выберите стратегию (профиль)" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

                <ListBox Name="LstStrategies" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="LstStrategies_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Name="BtnFav" Content="♡" FontSize="20" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnFav_Click" VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Foreground" Value="Gray"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Foreground" Value="Gold"/>
                                                    <Setter Property="Content" Value="♥"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Name="TxtProfileName" Text="{Binding Name}" Foreground="#4CAF50" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Name="TxtProfileDesc" Text="{Binding Description}" Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- СТРАНИЦА 3: СПИСКИ -->
            <Grid Name="PageLists" Grid.Row="1" Margin="30" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Редактор списков:" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                    <ComboBox Name="CmbLists" Width="250" Height="30" SelectionChanged="CmbLists_SelectionChanged" VerticalAlignment="Center">
                        <ComboBoxItem Content="list-general.txt" Tag="list-general.txt"/>
                        <ComboBoxItem Content="list-google.txt" Tag="list-google.txt"/>
                        <ComboBoxItem Content="list-exclude.txt" Tag="list-exclude.txt"/>
                        <ComboBoxItem Content="list-general-user.txt" Tag="list-general-user.txt"/>
                        <ComboBoxItem Content="list-exclude-user.txt" Tag="list-exclude-user.txt"/>
                        <ComboBoxItem Content="ipset-exclude.txt" Tag="ipset-exclude.txt"/>
                        <ComboBoxItem Content="ipset-exclude-user.txt" Tag="ipset-exclude-user.txt"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock Grid.Row="1" Name="TxtListHint" Text="Выберите файл для редактирования." Foreground="Gray" FontSize="12" Margin="0,0,0,10"/>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox Name="TxtListEditor" Grid.Row="0" Background="#0A0A0A" Foreground="White" FontFamily="Consolas" FontSize="14" 
                             AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                             BorderThickness="0" Padding="10" IsEnabled="False"/>

                    <Button Grid.Row="1" Name="BtnSaveList" Content="Сохранить изменения" Height="40" Margin="0,10,0,0" 
                            Click="BtnSaveList_Click" Background="#4CAF50" Foreground="White" BorderThickness="0" FontWeight="Bold" IsEnabled="False"/>
                </Grid>
            </Grid>

            <!-- СТРАНИЦА 4: НАСТРОЙКИ -->
            <Grid Name="PageSettings" Grid.Row="1" Margin="30" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Инструменты и обновления" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <StackPanel Grid.Row="1">
                    <Button Content="Обновить списки IP (ipset)" Width="300" Height="40" Margin="0,0,0,10" Click="BtnUpdateIpset_Click" Background="#333" Foreground="White" BorderThickness="0"/>
                    <Button Content="Очистить кэш Discord" Width="300" Height="40" Margin="0,0,0,10" Click="BtnClearDiscord_Click" Background="#333" Foreground="White" BorderThickness="0"/>
                    <Button Content="Проверить обновления Zapret" Width="300" Height="40" Margin="0,0,0,10" Click="BtnCheckUpdates_Click" Background="#333" Foreground="White" BorderThickness="0"/>
                    <Button Content="Запустить диагностику" Width="300" Height="40" Margin="0,0,0,20" Click="BtnDiagnostics_Click" Background="#333" Foreground="White" BorderThickness="0"/>
                </StackPanel>

                <!-- Блок кастомизации -->
                <StackPanel Grid.Row="2" Margin="0,10,0,10">
                    <TextBlock Text="Бета-функция: Кастомизация" Foreground="#F44336" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Button Content="Фон" Width="100" Height="30" Margin="0,0,10,0" Click="BtnPickBgColor_Click" Background="#333" Foreground="White" BorderThickness="0"/>
                        <Button Content="Меню" Width="100" Height="30" Margin="0,0,10,0" Click="BtnPickSidebarColor_Click" Background="#333" Foreground="White" BorderThickness="0"/>
                        <Button Content="Текст профилей" Width="120" Height="30" Margin="0,0,10,0" Click="BtnPickProfileTextColor_Click" Background="#333" Foreground="White" BorderThickness="0"/>
                        <Button Content="Логи" Width="100" Height="30" Click="BtnPickLogTextColor_Click" Background="#333" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel Name="PnlDiagnostics" Orientation="Vertical"/>
                </ScrollViewer>
            </Grid>

            <!-- СТРАНИЦА 5: ЛОГИ -->
            <Grid Name="PageLogs" Grid.Row="1" Margin="30" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Логи работы" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

                <TextBox Name="TxtLogs" Grid.Row="1" Background="#0A0A0A" Foreground="#00FF00" FontFamily="Consolas" FontSize="12" 
                         IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="10"
                         Text="[Система] Программа запущена. Ожидание действий..."/>
            </Grid>
        </Grid>
    </Grid>
</Window>